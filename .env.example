# ==============================================================================
# GDG on Campus · Info Session - Örnek Ortam Değişkenleri (.env.example)
# Bu dosyayı '.env' adıyla kopyalayıp kendi yerel değerlerinizi girin.
# DİKKAT: .env dosyasını ASLA git'e eklemeyin / commit etmeyin!
# ==============================================================================

# --- FRONTEND YAPILANDIRMASI ---
# Mock modu: 'false' ise gerçek API ve veritabanı kullanılır; 'true' ise frontend tarayıcı içi sahte verilerle çalışır.
VITE_USE_MOCK=false

# API ana adresi: Vercel üzerinde veya aynı etki alanında boş bırakın.
# Yerel geliştirme yaparken Vite proxy'si otomatik olarak localhost:3000'e yönlendirir.
VITE_API_BASE_URL=

# Sadece VITE_USE_MOCK=true olduğunda kullanılan yerel mock admin parolası.
VITE_ADMIN_PASSWORD=yerel-mock-parola

# --- BACKEND YAPILANDIRMASI (backend/.env veya Vercel Panelinden tanımlanır) ---
# Yerel API sunucusu portu
PORT=3000

# PostgreSQL veritabanı bağlantı adresi (örn. Neon Postgres: postgres://user:password@ep-xyz.fra1.neon.tech/neondb?sslmode=require)
DATABASE_URL=

# Üretim Admin Paneli parolası (Güçlü ve tahmin edilemez bir parola seçin)
ADMIN_PASSWORD=

# CORS izni (Frontend ayrı bir alan adındaysa virgülle ayırarak yazın, örn: http://localhost:5173,https://gdg.algoforge.com.tr)
FRONTEND_ORIGIN=
